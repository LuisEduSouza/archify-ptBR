---
import Brand from './Brand';
import globe from '../assets/globe.svg';
interface Props { page: 'index' | 'gallery' | 'guide' | 'start' | 'community' | 'agent-diagrams' | 'cases/mco-runtime' }
const { page } = Astro.props;
const home = page === 'index';
const identities = {
  'cases/mco-runtime': { en: '/ MCO case', zh: '/ MCO 案例', 'pt-BR': '/ Caso MCO', label: 'Página inicial do Archify' },
  'agent-diagrams': { en: '/ agent diagrams', zh: '/ Agent 画图', 'pt-BR': '/ Diagramas de agentes', label: 'Página inicial do Archify' },
  gallery: { en: '/ proof lab', zh: '/ 验证作品集', 'pt-BR': '/ evidência', label: 'Voltar à página inicial do Archify' },
  guide: { en: '/ guide', zh: '/ 场景指南', 'pt-BR': '/ guia', label: 'Página inicial do Archify' },
  start: { en: '/ start', zh: '/ 快速上手', 'pt-BR': '/ comece agora', label: 'Página do projeto Archify' },
  community: { en: '/ community', zh: '/ 社区包', 'pt-BR': '/ comunidade', label: 'Página inicial do Archify' },
};
const identity = home ? undefined : identities[page];
const guideKeys: Record<string, string> = { guide: 'navGuide', gallery: 'navProof', start: 'navStart', community: 'navCommunity' };
const links = [
  { page: 'guide', en: 'Guide', zh: '场景指南', 'pt-BR': 'Guia' },
  { page: 'gallery', en: 'Proof Lab', zh: '验证作品集', 'pt-BR': 'Evidência' },
  { page: 'start', en: 'Get started', zh: '开始使用', 'pt-BR': 'Comece agora' },
  { page: 'community', en: 'Community', zh: '社区包', 'pt-BR': 'Comunidade' },
];
---
<nav class="site-nav" aria-label="Navegação principal">
  <a class="nav-logo" href={home ? '#' : './'} aria-label={identity?.label}>
    <Brand />
    {identity && <span class="nav-logo-path" data-en={identity.en} data-zh={identity.zh} data-pt-br={identity['pt-BR']}>{identity.en}</span>}
  </a>
  <div class="nav-right">
    <div class="nav-links">
    {links.map(link => <a class="nav-link" href={`${link.page}.html`} aria-current={page === link.page ? 'page' : undefined} {...(home ? { 'data-i18n': `nav-${link.page}` } : page === 'guide' ? { 'data-i18n': guideKeys[link.page] } : { 'data-en': link.en, 'data-zh': link.zh, 'data-pt-br': link['pt-BR'] })}>{link.en}</a>)}
    <a class="nav-link" href="https://github.com/tt-a1i/archify" target="_blank" rel="noopener">GitHub<span class="nav-stars" data-gh-stars hidden></span></a>
    </div>
    <button class="btn-theme" type="button" data-theme-toggle aria-label="Alternar para o tema escuro">
      <svg class="theme-moon" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M13.5 9.6A5.8 5.8 0 0 1 6.4 2.5a5.8 5.8 0 1 0 7.1 7.1Z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/></svg>
      <svg class="theme-sun" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><circle cx="8" cy="8" r="3" stroke="currentColor" stroke-width="1.4"/><path d="M8 1.2v1.6M8 13.2v1.6M1.2 8h1.6M13.2 8h1.6M3.2 3.2l1.1 1.1M11.7 11.7l1.1 1.1M3.2 12.8l1.1-1.1M11.7 4.3l1.1-1.1" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/></svg>
    </button>
    <div class="language-picker" data-language-picker>
      <button class="language-toggle" type="button" aria-label="Escolher idioma" aria-haspopup="menu" aria-expanded="false" aria-controls="language-menu" data-language-toggle>
        <img src={globe.src} alt="" width="20" height="20" />
      </button>
      <div class="language-menu" id="language-menu" role="menu" aria-label="Idiomas disponíveis" hidden>
        <a role="menuitem" data-language-option="en" href="./">English <span>EN</span></a>
        <a role="menuitem" data-language-option="zh" href="zh/">中文 <span>ZH</span></a>
        <a role="menuitem" data-language-option="pt-BR" href="pt-BR/">Português (Brasil) <span>PT-BR</span></a>
      </div>
    </div>
    <a class="btn btn-primary nav-cta" href={page === 'start' ? '#install' : home ? 'start.html#install' : 'start.html'} {...(home ? { 'data-i18n': 'nav-install' } : page === 'guide' ? { 'data-i18n': 'navInstall' } : { 'data-en': 'Install Skill', 'data-zh': '安装技能', 'data-pt-br': 'Instalar Skill' })}>Instalar Skill</a>
  </div>
</nav>
<script is:inline>
  (function () {
    var body = document.body;
    var sync = function () { body.classList.toggle('nav-scrolled', window.scrollY > 8); };
    window.addEventListener('scroll', sync, { passive: true });
    sync();
    var root = document.documentElement;
    var meta = document.querySelector('meta[name="theme-color"]');
    var toggle = document.querySelector('[data-theme-toggle]');
    var syncTheme = function () {
      var dark = root.getAttribute('data-theme') === 'dark';
      if (meta) meta.setAttribute('content', dark ? '#07080a' : '#f5f6f3');
      toggle.setAttribute('aria-label', dark ? 'Alternar para o tema claro' : 'Alternar para o tema escuro');
      toggle.setAttribute('aria-pressed', String(dark));
    };
    toggle.addEventListener('click', function () {
      var next = root.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
      root.setAttribute('data-theme', next);
      try { localStorage.setItem('archify-site-theme', next); } catch (_) {}
      syncTheme();
      window.dispatchEvent(new CustomEvent('archify:themechange', { detail: { theme: next } }));
    });
    syncTheme();
    var picker = document.querySelector('[data-language-picker]');
    if (picker) {
      var languageToggle = picker.querySelector('[data-language-toggle]');
      var languageMenu = picker.querySelector('[role="menu"]');
      var languageOptions = Array.prototype.slice.call(picker.querySelectorAll('[data-language-option]'));
      var closeLanguageMenu = function (focusToggle) {
        languageMenu.hidden = true;
        languageToggle.setAttribute('aria-expanded', 'false');
        if (focusToggle) languageToggle.focus();
      };
      var openLanguageMenu = function () {
        languageMenu.hidden = false;
        languageToggle.setAttribute('aria-expanded', 'true');
        var current = window.ArchifySiteLanguage && window.ArchifySiteLanguage.read();
        languageOptions.forEach(function (option) {
          var selected = option.getAttribute('data-language-option') === current;
          option.hidden = selected;
          if (!selected) option.href = window.ArchifySiteLanguage.pageFrom ? window.ArchifySiteLanguage.pageFrom(option.getAttribute('data-language-option')) : option.href;
        });
        var first = languageOptions.find(function (option) { return !option.hidden; });
        if (first) first.focus();
      };
      languageToggle.addEventListener('click', function () {
        if (languageMenu.hidden) openLanguageMenu(); else closeLanguageMenu(false);
      });
      picker.addEventListener('keydown', function (event) {
        if (event.key === 'Escape' && !languageMenu.hidden) { event.preventDefault(); closeLanguageMenu(true); }
        if (event.key === 'ArrowDown' && event.target === languageToggle) { event.preventDefault(); openLanguageMenu(); }
        if (!languageMenu.hidden && (event.key === 'ArrowDown' || event.key === 'ArrowUp')) {
          var available = languageOptions.filter(function (option) { return !option.hidden; });
          var index = available.indexOf(document.activeElement);
          var next = event.key === 'ArrowDown' ? (index + 1) % available.length : (index - 1 + available.length) % available.length;
          event.preventDefault(); if (available[next]) available[next].focus();
        }
      });
      document.addEventListener('click', function (event) { if (!picker.contains(event.target)) closeLanguageMenu(false); });
      languageOptions.forEach(function (option) { option.addEventListener('click', function () { closeLanguageMenu(false); }); });
    }
    var KEY = 'archify-gh-stars';
    var paint = function (n) {
      if (!n) return;
      var label = n >= 1000 ? (n / 1000).toFixed(n >= 10000 ? 0 : 1) + 'k' : String(n);
      document.querySelectorAll('[data-gh-stars]').forEach(function (node) { node.textContent = label; node.hidden = false; });
    };
    var cached = null;
    try { cached = JSON.parse(sessionStorage.getItem(KEY) || 'null'); } catch (_) {}
    if (cached && Date.now() - cached.at < 36e5) {
      document.addEventListener('DOMContentLoaded', function () { paint(cached.n); });
      return;
    }
    fetch('https://api.github.com/repos/tt-a1i/archify').then(function (r) { return r.ok ? r.json() : null; }).then(function (repo) {
      var n = repo && repo.stargazers_count;
      if (!n) return;
      try { sessionStorage.setItem(KEY, JSON.stringify({ n: n, at: Date.now() })); } catch (_) {}
      paint(n);
    }).catch(function () {});
  })();
</script>