---
import { version, versioned, jsonScript, starts } from '../data/site';
import { productChannel } from '../data/product-facts';
import SupportedDiagrams from '../components/SupportedDiagrams.astro';
import SiteLayout from '../layouts/SiteLayout.astro';
import Navigation from '../components/Navigation.astro';
import head from '../data/start-head.html?raw';
import css from '../styles/start.css?raw';
import clipboardScript from '../scripts/clipboard.js?raw';
import pageScript from '../scripts/start.js?raw';
const { lang = 'en' } = Astro.props;
---
<SiteLayout page="start" lang={lang} head={versioned(head)} css={css}>

  <div class="grid-bg" aria-hidden="true"></div>

  <Navigation page="start" />

  <main>
    <header class="lead">
      <div>
        <p class="lead-label" data-en="Start with words, Mermaid, or code" data-zh="从描述、Mermaid 或代码开始" data-pt-BR="Comece com palavras, Mermaid ou código">Start with words, Mermaid, or code</p>
        <h1><span data-en="Describe it." data-zh="直接说，" data-pt-BR="Descreva.">Describe it.</span><span class="title-gap" aria-hidden="true"> </span><em data-en="Archify maps it." data-zh="Archify 就能画。" data-pt-BR="O Archify transforma em diagrama.">Archify maps it.</em></h1>
      </div>
      <div>
        <p class="lead-copy" data-en="No existing repository is required. Describe a plan, a process, or a system to a coding agent with Archify installed, file access, and command execution with Node.js. If code exists, the same skill can inspect it for evidence." data-zh="不需要已有代码库。向已安装 Archify、能够读写文件并通过 Node.js 执行命令的 Coding Agent 描述计划、流程或系统；如果有代码，也可以让它检查仓库作为证据。" data-pt-BR="Não é necessário ter um repositório existente. Descreva um plano, processo ou sistema a um agente de programação com o Archify instalado, acesso aos arquivos e capacidade de executar comandos com Node.js. Se já houver código, a mesma skill poderá analisá-lo para encontrar evidências.">No existing repository is required. Describe a plan, a process, or a system to a coding agent with Archify installed, file access, and command execution with Node.js. If code exists, the same skill can inspect it for evidence.</p>
        <div class="trust-line" data-en="Start from your description once the agent environment is ready." data-zh="配置好 Agent 环境后，就可以从一段描述开始。" data-pt-BR="Comece a partir da sua descrição assim que o ambiente do agente estiver pronto.">Start from your description once the agent environment is ready.</div>
      </div>
    </header>

    <section class="type-shell" aria-labelledby="type-label">
      <p class="type-label"><span data-en="Choose how to start" data-zh="选择如何开始" data-pt-BR="Escolha como começar.">Choose how to start</span><strong data-en="Repository optional" data-zh="代码库可选" data-pt-BR="Repositório opcional.">Repository optional</strong></p>
      <div class="input-paths" role="tablist" aria-label="Input source">
        <button class="input-path" type="button" role="tab" data-input="description"><strong data-en="Just describe it" data-zh="直接描述" data-pt-BR="Apenas descreva.">直接描述</strong><span data-en="No existing source files or repository needed. Use your configured coding agent." data-zh="无需已有源文件或代码库，使用已配置好的 Coding Agent。" data-pt-BR="Não é necessário ter arquivos de código-fonte ou um repositório existente. Utilize seu agente de programação configurado.">No existing source files or repository needed. Use your configured coding agent.</span></button>
        <button class="input-path" type="button" role="tab" data-input="repository"><strong data-en="Use a repository" data-zh="从代码库开始" data-pt-BR="Comece a partir de um repositório de código.">Use a repository</strong><span data-en="Let the agent inspect code when source evidence matters." data-zh="需要源码证据时，再让 Agent 检查代码。" data-pt-BR="Permita que o agente analise o código quando houver necessidade de evidências no código-fonte.">Let the agent inspect code when source evidence matters.</span></button>
      </div>
      <p class="question mermaid-guide-link"><a href="agent-diagrams.html#mermaid-input" data-en="Already have Mermaid? Learn how to use it as agent input →" data-zh="已有 Mermaid？了解怎样把它交给 Agent →" data-pt-BR="Já tem um diagrama Mermaid? Saiba como utilizá-lo como entrada para o agente →">Already have Mermaid? Learn how to use it as agent input →</a></p>
      <p class="type-label" id="type-label"><span data-en="Choose the question shape" data-zh="选择问题形态" data-pt-BR="Escolha o formato da pergunta.">Choose the question shape</span><strong data-en={`${Object.keys(starts).length} starting recipes`} data-zh={`${Object.keys(starts).length} 个入门配方`} data-pt-BR={`${Object.keys(starts).length} modelos iniciais`}>{Object.keys(starts).length} starting recipes</strong></p>
      <SupportedDiagrams />
      <div class="type-tabs" role="tablist" aria-label="Diagram type">
        <button class="type-tab" type="button" role="tab" data-type="architecture" data-en="Architecture" data-zh="架构图" data-pt-BR="Diagrama de arquitetura">Architecture</button>
        <button class="type-tab" type="button" role="tab" data-type="workflow" data-en="Workflow" data-zh="工作流" data-pt-BR="Fluxo de trabalho">Workflow</button>
        <button class="type-tab" type="button" role="tab" data-type="sequence" data-en="Sequence" data-zh="时序图" data-pt-BR="Diagrama de sequência.">Sequence</button>
        <button class="type-tab" type="button" role="tab" data-type="dataflow" data-en="Data flow" data-zh="数据流" data-pt-BR="Fluxo de dados.">Data flow</button>
        <button class="type-tab" type="button" role="tab" data-type="lifecycle" data-en="Lifecycle" data-zh="生命周期" data-pt-BR="Ciclo de vida">Lifecycle</button>
        <button class="type-tab" type="button" role="tab" data-type="erd" data-en="Entity-relationship" data-zh="实体关系图" data-pt-BR="Diagrama de Entidade-Relacionamento">Entity-relationship</button>
      </div>
    </section>

    <section class="workbench" aria-label="Archify quick start">
      <article class="panel" id="install">
        <div class="panel-kicker"><b>01</b><span data-en="Install the skill" data-zh="安装 Skill" data-pt-BR="Instale a Skill">Install the skill</span></div>
        <h2 data-en="Keep the tool local." data-zh="让工具留在本地。" data-pt-BR="Mantenha a ferramenta no ambiente local.">Keep the tool local.</h2>
        <p class="panel-intro" data-en="Choose Cursor, Codex, Claude Code, OpenCode, or GitHub Copilot. The switcher gives each one the same checked Skill and zero-dependency renderers—no vendor-specific fork." data-zh="选择 Cursor、Codex、Claude Code、OpenCode 或 GitHub Copilot。切换器为每个 Agent 提供同一份经过检查的 Skill 与零依赖渲染器，不维护厂商专属分叉。" data-pt-BR="Escolha entre Cursor, Codex, Claude Code, OpenCode ou GitHub Copilot. O seletor oferece a cada um a mesma Skill verificada e os mesmos renderizadores sem dependências, sem necessidade de versões específicas para cada fornecedor.">Choose Cursor, Codex, Claude Code, OpenCode, or GitHub Copilot. The switcher gives each one the same checked Skill and zero-dependency renderers—no vendor-specific fork.</p>

        <p class="question setup-guide-link"><a href="agent-diagrams.html#setup" data-en="Check environment requirements and Claude Code / Codex CLI setup →" data-zh="查看环境要求与 Claude Code / Codex CLI 配置说明 →" data-pt-BR="Verifique os requisitos do ambiente e a configuração do Claude Code / Codex CLI →">Check environment requirements and Claude Code / Codex CLI setup →</a></p>

        <div class="agent-picker">
          <p class="agent-picker-head"><span data-en="Choose your coding agent" data-zh="选择你的编码 Agent" data-pt-BR="Escolha seu agente de programação.">Choose your coding agent</span><strong id="agent-state">Codex · same Skill</strong></p>
          <div class="agent-tabs" role="tablist" aria-label="Coding agent">
            <button class="agent-tab" type="button" role="tab" data-agent="cursor">Cursor</button>
            <button class="agent-tab" type="button" role="tab" data-agent="codex">Codex</button>
            <button class="agent-tab" type="button" role="tab" data-agent="claude-code">Claude Code</button>
            <button class="agent-tab" type="button" role="tab" data-agent="opencode">OpenCode</button>
            <button class="agent-tab" type="button" role="tab" data-agent="github-copilot">GitHub Copilot</button>
          </div>
        </div>

        <div class="command-block">
          <div class="command-bar"><span data-en="Global install" data-zh="全局安装" data-pt-BR="Instalação global.">Global install</span><button class="copy-button" type="button" aria-describedby="install-copy-status" data-copy-source="install-command" data-en="Copy" data-zh="复制" data-pt-BR="Copiar">Copy</button></div>
          <pre id="install-command">npx -y skills add tt-a1i/archify --skill archify --agent codex --global --copy --yes</pre>
          <p id="install-copy-status" class="copy-status" role="status" aria-live="polite"></p>
        </div>
        <div class="command-block">
          <div class="command-bar"><span data-en="This repository only" data-zh="仅安装到当前仓库" data-pt-BR="Somente neste repositório.">This repository only</span><button class="copy-button" type="button" aria-describedby="project-copy-status" data-copy-source="project-command" data-en="Copy" data-zh="复制" data-pt-BR="Copiar">Copy</button></div>
          <pre id="project-command">npx -y skills add tt-a1i/archify --skill archify --agent codex --copy --yes</pre>
          <p id="project-copy-status" class="copy-status" role="status" aria-live="polite"></p>
        </div>
        <p class="secondary-note" data-en="The Start link carries only your agent, language, diagram type, input mode, and a coarse source label. Journey events stay in this browser session and are never sent by Archify. No repository path, title, node, relationship, or source JSON is recorded." data-zh="Start 链接只携带 Agent、语言、图表类型、输入模式和粗粒度来源标签。转化步骤只保存在当前浏览器会话中，Archify 不会发送这些数据，也不会记录仓库路径、标题、节点、关系或源 JSON。" data-pt-BR="O link de início contém apenas informações sobre o agente, o idioma, o tipo de diagrama, o modo de entrada e uma identificação genérica da origem. As etapas de conversão permanecem armazenadas apenas na sessão atual do navegador. O Archify não envia esses dados nem registra o caminho do repositório, títulos, node, relacionamentos ou o JSON de origem.">The Start link carries only your agent, language, diagram type, input mode, and a coarse source label. Journey events stay in this browser session and are never sent by Archify. No repository path, title, node, relationship, or source JSON is recorded.</p>
      </article>

      <article class="panel" aria-live="polite">
        <div class="panel-kicker"><b>02</b><span data-en="Ask one bounded question" data-zh="只问一个有边界的问题" data-pt-BR="Faça uma pergunta específica e delimitada">Ask one bounded question</span></div>
        <h2 id="recipe-title" data-en={starts.architecture.en.title} data-zh={starts.architecture.zh.title}>{starts.architecture.en.title}</h2>
        <p class="question" id="recipe-question" data-en={starts.architecture.en.question} data-zh={starts.architecture.zh.question}>{starts.architecture.en.question}</p>
        <ul class="include-list" id="include-list" aria-label="Required evidence">{starts.architecture.en.include.map((item, index) => <li data-en={item} data-zh={starts.architecture.zh.include[index]}>{item}</li>)}</ul>
        <p class="prompt-box" id="recipe-prompt" data-en={starts.architecture.en.descriptionPrompt} data-zh={starts.architecture.zh.descriptionPrompt}>{starts.architecture.en.descriptionPrompt}</p>
        <div class="actions">
          <button class="action action-primary" id="copy-starter" aria-describedby="copy-status" type="button" data-en="Copy install + prompt" data-zh="复制安装命令 + 提示词" data-pt-BR="Copiar comando de instalação + prompt">Copy install + prompt</button>
          <button class="action" id="copy-prompt" aria-describedby="copy-status" type="button" data-en="Prompt only" data-zh="仅复制提示词" data-pt-BR="Copiar apenas o prompt.">Prompt only</button>
          <a class="action" id="proof-link" href={`gallery.html#proof-${starts.architecture.proof}`} data-en="Open verified proof ↗" data-zh="打开验证成品 ↗" data-pt-BR="Abrir resultado verificado ↗">Open verified proof ↗</a>
          <a class="action" href="guide.html" data-en="Need another recipe?" data-zh="需要其他配方？" data-pt-BR="Precisa de outro modelo?">Need another recipe?</a>
        </div>
        <p id="copy-status" class="copy-status" role="status" aria-live="polite"></p>
        <p class="proof-meta" id="proof-meta">{starts.architecture.type} · {starts.architecture.presentation.preset} · {starts.architecture.presentation.motion}</p>
      </article>
    </section>

    <footer class="page-footer">
      <span data-en={`Archify v${version} · ${productChannel} · self-contained HTML · typed JSON source`} data-zh={`Archify v${version} · ${productChannel === 'development' ? '开发版' : '稳定版'} · 独立 HTML · 类型化 JSON 源`} data pt-BR={`Archify v${version} · ${productChannel} · HTML independente · fonte JSON tipada`}>Archify v{version} · {productChannel} · self-contained HTML · typed JSON source</span>
      <a href="https://github.com/tt-a1i/archify" data-en="View source on GitHub ↗" data-zh="在 GitHub 查看源码 ↗" data-pt-BR="Ver código-fonte no GitHub ↗">View source on GitHub ↗</a>
    </footer>
    <aside class="agent-guide-link" aria-label={lang === 'zh' ? 'Agent 画图指南' : 'Agent diagramming guide'}>
      <a href="agent-diagrams.html" data-en="From prompt to a diagram you can trust →" data-zh="从提示词到可检查的图 →" data-pt-BR="Do prompt a um diagrama em que você pode confiar →">From prompt to a diagram you can trust →</a>
      <p data-en="Learn how to author, review and share diagrams with your coding agent." data-zh="了解如何用 Coding Agent 编写、检查和分享图表。" data-pt-BR="Aprenda a criar, revisar e compartilhar diagramas com seu agente de programação.">Learn how to author, review and share diagrams with your coding agent.</p>
    </aside>
  </main>

  <script is:inline id="start-data" type="application/json" set:html={jsonScript(starts)}></script>
  <script is:inline src="assets/site-language.js"></script>
  <script is:inline set:html={versioned(clipboardScript + "\n" + pageScript)}></script>

</SiteLayout>
